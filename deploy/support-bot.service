[Unit]
Description=Support Bot in Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=/opt/support-bot
Environment=COMPOSE_FILE=/opt/support-bot/current/compose.yml
EnvironmentFile=-/etc/support-bot/systemd.env
ExecStart=/usr/bin/docker compose --project-name support-bot --env-file /opt/support-bot/current/image.env up --no-build --abort-on-container-exit --exit-code-from bot
ExecStop=/usr/bin/docker compose --project-name support-bot --env-file /opt/support-bot/current/image.env stop --timeout 30
ExecStopPost=/usr/bin/docker compose --project-name support-bot --env-file /opt/support-bot/current/image.env down --remove-orphans
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=support-bot

[Install]
WantedBy=multi-user.target
