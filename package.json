{
  "name": "support-bot",
  "version": "1.2.0",
  "description": "Discord typescript support bot for tebex and craftingstore",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node --env-file-if-exists=.env ./dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch ./src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test src/test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:database": "node scripts/check-database.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "credentials:check": "node --env-file-if-exists=.env dist/tools/reencrypt.js",
    "credentials:rotate": "node --env-file-if-exists=.env dist/tools/reencrypt.js --apply",
    "db:migrate": "node --env-file-if-exists=.env dist/tools/migrate.js",
    "lint": "oxlint src scripts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.28.1",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.2 <25"
  }
}
